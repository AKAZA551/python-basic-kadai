        "class Human:\n",
        "\n",
        "  def __init__(self,name: str,age :int):\n",
        "    self.name=name\n",
        "    self.age=age\n",
        "\n",
        "  def printinfo(self):\n",
        "    print(f\"あなたは{self.name}さん。{self.age}歳です。\")\n",
        "\n",
        "person=Human(\"五条　悟\",29)\n",
        "\n",
        "person.printinfo()"
      ]
    }
